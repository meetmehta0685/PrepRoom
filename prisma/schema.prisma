generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["preproom"]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
  @@schema("preproom")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("preproom")
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  meetings      Meeting[]
  interviews    InterviewSession[] @relation("CandidateInterviews")

  @@map("users")
  @@schema("preproom")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@schema("preproom")
  @@map("verification_tokens")
}

model Meeting {
  id          String            @id @default(cuid())
  code        String            @unique
  livekitRoom String            @unique
  title       String            @default("Study session")
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  endedAt     DateTime?
  interview   InterviewSession?

  @@index([createdById])
  @@map("meetings")
  @@schema("preproom")
}

enum InterviewMode {
  AI
  PEER

  @@schema("preproom")
}

enum InterviewTrack {
  FULLSTACK
  FRONTEND
  BACKEND
  DSA
  SYSTEM_DESIGN
  BEHAVIORAL

  @@schema("preproom")
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR

  @@schema("preproom")
}

enum InterviewStatus {
  ACTIVE
  COMPLETED
  ABANDONED

  @@schema("preproom")
}

enum InterviewMessageRole {
  INTERVIEWER
  CANDIDATE

  @@schema("preproom")
}

enum InterviewQuestionType {
  TEXT
  CODE

  @@schema("preproom")
}

model InterviewSession {
  id                String             @id @default(cuid())
  candidateId       String
  candidate         User               @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: Cascade)
  interviewerType   InterviewMode
  track             InterviewTrack
  level             ExperienceLevel
  jobTitle          String             @default("Software Engineer")
  resumeName        String?
  resumeText        String?            @db.Text
  resumeFingerprint String?
  status            InterviewStatus    @default(ACTIVE)
  meetingId         String?            @unique
  meeting           Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  messages          InterviewMessage[]
  report            InterviewReport?
  createdAt         DateTime           @default(now())
  completedAt       DateTime?

  @@index([candidateId, createdAt])
  @@map("interview_sessions")
  @@schema("preproom")
}

model InterviewMessage {
  id           String                @id @default(cuid())
  interviewId  String
  interview    InterviewSession      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role         InterviewMessageRole
  content      String                @db.Text
  questionType InterviewQuestionType @default(TEXT)
  codeLanguage String?
  createdAt    DateTime              @default(now())

  @@index([interviewId, createdAt])
  @@map("interview_messages")
  @@schema("preproom")
}

model InterviewReport {
  id                  String                    @id @default(cuid())
  interviewId         String                    @unique
  interview           InterviewSession          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallScore        Int
  technicalScore      Int
  communicationScore  Int
  problemSolvingScore Int                       @default(0)
  roleFitScore        Int                       @default(0)
  resumeDepthScore    Int                       @default(0)
  isBaseline          Boolean                   @default(false)
  summary             String                    @db.Text
  hiringSignal        String                    @default("More evidence needed") @db.Text
  strengths           String[]
  improvements        String[]
  nextSteps           String[]
  questionReviews     InterviewQuestionReview[]
  createdAt           DateTime                  @default(now())

  @@map("interview_reports")
  @@schema("preproom")
}

model InterviewQuestionReview {
  id              String                @id @default(cuid())
  reportId        String
  report          InterviewReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  questionNumber  Int
  question        String                @db.Text
  candidateAnswer String                @db.Text
  benchmarkAnswer String                @db.Text
  score           Int
  strengths       String[]
  gaps            String[]
  betterApproach  String                @db.Text
  questionType    InterviewQuestionType @default(TEXT)
  codeLanguage    String?

  @@unique([reportId, questionNumber])
  @@map("interview_question_reviews")
  @@schema("preproom")
}
